{
  "name": "first-light",
  "private": true,
  "version": "0.1.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "watch": "vite build --watch",
    "build:firefox": "npm run build && node scripts/firefox.mjs",
    "firefox": "npm run build:firefox && web-ext run --source-dir dist-firefox --start-url about:newtab",
    "lint:firefox": "web-ext lint --source-dir dist-firefox",
    "preview": "vite preview",
    "package": "npm run build:firefox && node scripts/package.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "ical.js": "^2.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "web-ext": "^10.8.0"
  }
}
